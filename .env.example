# Klimavani Environment Configuration — Copy this file to .env and fill in values
# DO NOT commit .env with real secrets to version control

# Express server port (Vercel/Render override this with their own PORT)
PORT=5000

# Runtime environment (development | production)
NODE_ENV=development

# Directory where articles.json is stored (relative to project root)
DATA_DIR=./data

# How often the RSS collector runs automatically (minutes)
COLLECTION_INTERVAL_MINUTES=30

# Max articles fetched per source per collection run
MAX_ARTICLES_PER_FEED=20

# HTTP request timeout for RSS fetch (milliseconds)
REQUEST_TIMEOUT_MS=9000

# Frontend API base URL (consumed by Vite — NOT a secret, embedded in JS bundle)
# LOCAL DEV: Use /api — Vite dev server proxies /api/* to Express on port 5000
# PRODUCTION (Vercel): Set to /api in Vercel Environment Variables
VITE_API_URL=/api
